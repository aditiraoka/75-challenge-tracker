// backend\prisma\schema.prisma
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
  //url = "file:./dev.db"
}

// Model for master list of tasks
model taskRules {
  id        Int   @id @default(autoincrement())
  taskName  String   @unique
  createdAt DateTime @default(now())
}

// Model to represent each day
model DailyLog {
  id        Int   @id @default(autoincrement())
  dayNumber Int
  date      String
  logTasks  LogTask[]
  createdAt DateTime  @default(now())

  @@unique([dayNumber])
}

// Model for log of task for a particular day
model LogTask {
  id         Int   @id @default(autoincrement())
  taskName   String
  status     Status   @default(PENDING)
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id])
  dailyLogId Int
}

enum Status {
  DONE
  PENDING
}